:root {
  --paper: #F6F5F1;
  --ink: #17181A;
  --line: #000000;
  --muted: #5B5D57;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: 'Inter', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- Header ---------- */

.site-header {
  max-width: 1100px;
  margin: 0 auto;
  padding: 56px 32px 40px;
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid #D9D6CC;
}

.name {
  font-family: 'Archivo Black', sans-serif;
  font-weight: 400;
  font-size: clamp(1.5rem, 2.6vw, 1.75rem);
  letter-spacing: -0.005em;
  margin: 0;
}

.hero-name {
  font-family: 'Archivo Black', sans-serif;
  font-weight: 400;
  font-size: clamp(3.5rem, 11vw, 8rem);
  line-height: 0.95;
  letter-spacing: -0.01em;
  margin: 64px 0 24px;
  text-align: center;
}

.name .dot {
  color: var(--ink);
  font-size: 0.7em;
  margin-right: 2px;
}

.site-nav {
  display: flex;
  gap: 28px;
  font-size: 1rem;
}

.site-nav a {
  color: var(--ink);
  text-decoration: none;
  padding-bottom: 4px;
  border-bottom: 1px solid transparent;
  transition: border-color 0.15s ease;
}

.site-nav a:hover,
.site-nav a:focus-visible {
  border-bottom-color: var(--ink);
}

.nav-blog {
  border: 1px solid var(--ink);
  border-radius: 999px;
  padding: 6px 16px;
}

.nav-blog:hover,
.nav-blog:focus-visible {
  background: var(--ink);
  color: var(--paper);
  border-bottom-color: var(--ink);
}

/* ---------- Project grid ---------- */

.project-grid {
  max-width: 1100px;
  margin: 0 auto;
  padding: 48px 32px 96px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px 32px;
}

.project-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.project-photo {
  aspect-ratio: 1 / 1;
  border: 1.5px solid var(--line);
  overflow: hidden;
  background: #EAE8E1;
}

.project-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.project-title {
  font-family: 'Archivo Black', sans-serif;
  font-weight: 400;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin: 0;
}

/* ---------- Footer ---------- */

.site-footer {
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px 32px 56px;
  color: var(--muted);
  font-size: 0.85rem;
}

/* ---------- Responsive ---------- */

@media (max-width: 720px) {
  .project-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 460px) {
  .project-grid {
    grid-template-columns: 1fr;
  }

  .site-header {
    flex-direction: column;
    align-items: flex-start;
  }
}
